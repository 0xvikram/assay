{
  "name": "assay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Is this agent's reputation real? A paid pre-flight check for ERC-8004 agents.",
  "scripts": {
    "assay": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "agent:pay": "tsx --env-file=.env src/agent/pay.ts",
    "hcs:create-topic": "tsx --env-file=.env scripts/hcs-create-topic.ts",
    "register:self": "tsx --env-file=.env scripts/register-self.ts",
    "mcp": "tsx --env-file=.env bin/assay-mcp.ts",
    "agent:pay-arc": "tsx --env-file=.env src/agent/pay-arc.ts",
    "treasury:setup": "tsx --env-file=.env scripts/treasury-setup.ts",
    "treasury:demo": "tsx --env-file=.env scripts/treasury-demo.ts",
    "agent:quote": "tsx --env-file=.env src/agent/quote.ts",
    "lending:demo": "tsx scripts/lending-demo.ts",
    "guard:demo": "tsx --env-file=.env scripts/guard-demo.ts",
    "tag:farm": "tsx --env-file=.env scripts/tag-farm.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.4.0",
    "@hiero-ledger/sdk": "^2.85.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "^3.42.0",
    "@worldcoin/idkit": "^4.2.3",
    "@worldcoin/idkit-core": "^4.2.4",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "@x402/hedera": "^2.25.0",
    "@x402/mcp": "^2.25.0",
    "@x402/next": "^2.25.0",
    "@x402/paywall": "^2.25.0",
    "next": "^16.3.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.56.3",
    "zod": "^3.25.76"
  }
}
