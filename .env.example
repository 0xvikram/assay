# Subgraph Studio / decentralised network gateway key
GRAPH_API_KEY=
PUBLIC_BASE_URL=          # https://<project>.vercel.app — the hosted origin, used in /api/openapi servers

# --- Hedera (Phase C) — two ECDSA testnet accounts from portal.hedera.com ---
HEDERA_SERVICE_ACCOUNT_ID=      # 0.0.xxxxx — receives payments, writes HCS receipts
HEDERA_SERVICE_PRIVATE_KEY=     # 0x… ECDSA
HEDERA_AGENT_ACCOUNT_ID=        # 0.0.yyyyy — the reference paying agent
HEDERA_AGENT_PRIVATE_KEY=       # 0x… ECDSA
HCS_TOPIC_ID=                   # from `npm run hcs:create-topic`
X402_FACILITATOR_URL=           # default https://api.testnet.blocky402.com
X402_ASSET=                     # hbar (default, no token association) | usdc (0.0.429274, both accounts must associate)
HEDERA_MIRROR_URL=              # default https://testnet.mirrornode.hedera.com

# --- Base Sepolia (Phase D receipt) — two EVM keys, fund both from a Base Sepolia faucet ---
SERVICE_EVM_PRIVATE_KEY=        # 0x… owns the Assay ERC-8004 registration (npm run register:self)
AGENT_EVM_PRIVATE_KEY=          # 0x… the paying agent; writes payment-backed feedback (giveFeedback)
ASSAY_AGENT_ID=                 # printed by npm run register:self
BASE_SEPOLIA_RPC_URL=           # default https://sepolia.base.org
IPFS_API_URL=                   # default https://api.thegraph.com/ipfs/api/v0 (the node the indexer reads)

# --- Arc testnet (Phase G) — Circle Gateway batching; USDC from faucet.circle.com ---
ARC_SELLER_ADDRESS=             # optional; defaults to the SERVICE_EVM_PRIVATE_KEY address
INTENDED_SPEND=                 # tinybar the reference agent intends to spend with a counterparty (default 10000000)
ARC_GATEWAY_URL=                # default https://gateway-api-testnet.circle.com (mainnet: https://gateway-api.circle.com)

# --- Privy (Phase G) — dashboard.privy.io → app ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PUBLIC_KEY=   # printed by npm run treasury:setup (P-256, base64 DER)
PRIVY_AUTHORIZATION_PRIVATE_KEY=  # the quorum's signer
PRIVY_WALLET_ID=
PRIVY_POLICY_ID=
PRIVY_QUORUM_ID=
TREASURY_ALLOWLIST=               # optional extra 0x addresses, comma-separated
COUNTERPARTY_SPEND_WEI=           # default 1000000000000 (0.000001 ETH) — the counterparty leg through the Privy wallet

# --- World (Phase H) — developer.world.org → app + RP + action; sandbox on Android ---
NEXT_PUBLIC_WLD_APP_ID=           # app_…
NEXT_PUBLIC_WLD_RP_ID=            # rp_…
NEXT_PUBLIC_WLD_ACTION=assay-escalation
NEXT_PUBLIC_WLD_ENVIRONMENT=sandbox
RP_SIGNING_KEY=                   # hex signing key from the portal — server only, shown once

# --- Uniswap (Phase I) — developers.uniswap.org/dashboard ---
UNISWAP_API_KEY=
UNISWAP_API_URL=                  # default https://trade-api.gateway.uniswap.org/v1
SERVICE_EVM_ADDRESS=              # optional swapper address for quotes (defaults to a placeholder)
